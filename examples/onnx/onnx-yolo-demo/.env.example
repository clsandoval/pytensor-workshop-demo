# Environment Variables for YOLO11n Training
# Copy this file to .env and configure as needed:
#   cp .env.example .env

# =============================================================================
# PyTensor Configuration
# =============================================================================

# Device to use: cuda, cpu, or opencl
# For GPU training, use cuda
PYTENSOR_FLAGS="device=cuda,floatX=float32,optimizer=fast_run"

# Optional: Enable PyTensor compilation cache
# PYTENSOR_FLAGS="device=cuda,floatX=float32,optimizer=fast_run,base_compiledir=~/.pytensor"

# =============================================================================
# JAX Configuration
# =============================================================================

# Force JAX to use GPU (usually auto-detected)
# JAX_PLATFORM_NAME=cuda

# Control JAX memory allocation
# Set to 'false' to disable memory preallocation (useful for multiple processes)
XLA_PYTHON_CLIENT_PREALLOCATE=true

# Limit GPU memory usage (0.0 to 1.0)
# Use 0.9 to leave some memory for other processes
XLA_PYTHON_CLIENT_MEM_FRACTION=0.9

# Enable JAX GPU memory growth (allocate as needed)
# XLA_PYTHON_CLIENT_ALLOCATOR=platform

# =============================================================================
# CUDA Configuration
# =============================================================================

# Specify which GPU(s) to use (comma-separated for multiple GPUs)
# Default: Use all available GPUs
# CUDA_VISIBLE_DEVICES=0

# For multiple GPUs:
# CUDA_VISIBLE_DEVICES=0,1

# To use only second GPU:
# CUDA_VISIBLE_DEVICES=1

# CUDA library path (usually auto-detected)
# LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH

# =============================================================================
# Weights & Biases (WandB) Configuration
# =============================================================================

# WandB API Key (alternative to 'wandb login')
# Get your key from: https://wandb.ai/authorize
# WANDB_API_KEY=your_api_key_here

# WandB project name
WANDB_PROJECT=yolo11n-pytensor

# WandB entity (username or team name)
# WANDB_ENTITY=your_username

# Disable WandB (set to 'true' to disable)
# WANDB_DISABLED=false

# WandB run notes
# WANDB_NOTES="Training YOLO11n on COCO dataset"

# WandB tags (comma-separated)
# WANDB_TAGS="yolo11n,pytensor,gpu-training"

# =============================================================================
# Training Configuration (Optional - can also use command-line args)
# =============================================================================

# Number of training epochs
# EPOCHS=100

# Batch size
# BATCH_SIZE=8

# Initial learning rate
# LEARNING_RATE=0.01

# Image size
# IMAGE_SIZE=320

# Number of classes
# NUM_CLASSES=2

# =============================================================================
# Dataset Configuration
# =============================================================================

# COCO dataset directory
# DATA_DIR=./data/coco

# =============================================================================
# System Configuration
# =============================================================================

# Number of CPU threads for data loading
# OMP_NUM_THREADS=4
# MKL_NUM_THREADS=4

# Python unbuffered output (useful for logging)
PYTHONUNBUFFERED=1
